STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
# Shared secret you choose for the Strava webhook subscription handshake
# (pass the same value as verify_token when creating the push subscription)
STRAVA_VERIFY_TOKEN=your_random_verify_token

# Garmin Connect (Activity API) app credentials
GARMIN_CLIENT_ID=your_garmin_client_id
GARMIN_CLIENT_SECRET=your_garmin_client_secret
# Random secret you choose (letters, digits, - and _ only). The push URL set in
# Garmin's endpoint configuration ends in it: .../garminPush/<this key>
GARMIN_PUSH_KEY=your_random_push_key

# Garmin series + esMcp (docs/garmin-series.md). Comma-separated ESL uids that
# keep a 5-second series of every Garmin activity; the first is the account
# esMcp serves.
GARMIN_SERIES_UIDS=
# At least 32 random URL-safe characters; the connector URL ends in it:
# .../esMcp/<this key>
ES_MCP_KEY=
